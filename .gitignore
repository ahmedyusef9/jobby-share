.resolved-prompt-*
node_modules/
bun.lock
# JobSpy venv (scripts/parsers/jobspy-jobs.py). Machine-local and ~50MB; JobSpy
# needs Python >= 3.10 so it cannot share the system interpreter.
.venv-jobspy/
__pycache__/
# Report-number reservation sentinels (ephemeral, created by reserve-report-num.mjs)
reports/*-RESERVED.md

# Backup files written by normalize-statuses.mjs / dedup-tracker.mjs
*.bak
# web/src/app/api/cv/route.ts appends a timestamp AFTER .bak
# ("cv.md.bak-2026-07-28T20-39-45-726Z"), which `*.bak` does not match. Every CV
# save from the web UI therefore dropped an untracked copy of the full CV in the
# repo root, ready for `git add -A` to commit. cv.md itself is ignored; its
# backups must be too.
*.bak-*

